{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ufes.example/contracts/public/v1/events.json",
  "title": "Eventos SSE públicos do Gateway (v1.1)",
  "oneOf": [
    {
      "$ref": "#/$defs/meta"
    },
    {
      "$ref": "#/$defs/queued"
    },
    {
      "$ref": "#/$defs/delta"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/error"
    }
  ],
  "$defs": {
    "meta": {
      "type": "object",
      "required": [
        "request_id",
        "domain",
        "model",
        "node",
        "attempt",
        "schema"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "requested_domain": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "schema": {
          "type": [
            "string",
            "null"
          ]
        },
        "attempt_nodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "queued": {
      "type": "object",
      "required": [
        "position",
        "node"
      ],
      "properties": {
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "node": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "delta": {
      "type": "object",
      "required": [
        "seq",
        "text"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      }
    },
    "result": {
      "type": "object",
      "required": [
        "schema",
        "data"
      ],
      "properties": {
        "schema": {
          "type": "string"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "done": {
      "type": "object",
      "required": [
        "request_id",
        "finish_reason",
        "completion_tokens",
        "tokens_source"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "finish_reason": {
          "enum": [
            "stop",
            "length"
          ]
        },
        "completion_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "tokens_source": {
          "enum": [
            "backend_usage",
            "unknown"
          ]
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "code",
        "message",
        "partial",
        "retryable"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "partial": {
          "type": "boolean"
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}
